{
  "schema_version": "1.0.0",
  "controller": "blind-sniper",
  "concurrency": {
    "max_parallel_writers": 1,
    "read_only_reviewers_may_run_concurrently": true,
    "isolated_branch_required_for_each_writer": true
  },
  "agents": [
    {
      "id": "blind-sniper",
      "source": "native-operating-contract",
      "role": "AI operating lead and dispatcher",
      "authority": "coordinates; does not override Owner gates",
      "status": "active_in_chat_session"
    },
    {
      "id": "release-manager",
      "source": "native-blind-sniper-contract-adapted-from-openhands",
      "role": "release planning and gates",
      "status": "native_contract_present_execution_depends_on_host_or_worker",
      "path": "chatgpt-home/agents/release-manager.md"
    },
    {
      "id": "researcher",
      "source": "native-blind-sniper-contract",
      "path": "chatgpt-home/agents/researcher.md",
      "role": "primary-source technical and product research",
      "status": "native_contract_present_execution_depends_on_host_or_worker"
    },
    {
      "id": "planner",
      "source": "native-blind-sniper-contract",
      "path": "chatgpt-home/agents/planner.md",
      "role": "requirements decomposition and dependency planning",
      "status": "native_contract_present_execution_depends_on_host_or_worker"
    },
    {
      "id": "engineer",
      "source": "native-blind-sniper-contract",
      "path": "chatgpt-home/agents/engineer.md",
      "role": "bounded implementation",
      "status": "native_contract_present_execution_depends_on_host_or_worker"
    },
    {
      "id": "reviewer",
      "source": "native-blind-sniper-contract",
      "path": "chatgpt-home/agents/reviewer.md",
      "role": "independent correctness and security review",
      "status": "native_contract_present_execution_depends_on_host_or_worker"
    },
    {
      "id": "qa-verifier",
      "source": "native-blind-sniper-contract",
      "path": "chatgpt-home/agents/qa-verifier.md",
      "role": "test design and runtime acceptance",
      "status": "native_contract_present_execution_depends_on_host_or_worker"
    },
    {
      "id": "recovery",
      "source": "native-blind-sniper-contract",
      "path": "chatgpt-home/agents/recovery.md",
      "role": "diagnose failed runs and restore safe state",
      "status": "native_contract_present_execution_depends_on_host_or_worker"
    },
    {
      "id": "watcher",
      "source": "native-blind-sniper-contract",
      "path": "chatgpt-home/agents/watcher.md",
      "role": "Task progress observation, queue monitoring and correlated status reporting",
      "status": "native_contract_present_runtime_trigger_not_verified"
    },
    {
      "id": "shadow",
      "source": "native-blind-sniper-contract",
      "path": "chatgpt-home/agents/shadow.md",
      "role": "Independent adversarial audit of implementation, evidence, security and closure",
      "status": "native_contract_present_independent_execution_identity_not_verified"
    }
  ],
  "delegation_contract": {
    "required_fields": [
      "task_id",
      "objective",
      "repository",
      "base_commit",
      "allowed_paths",
      "forbidden_actions",
      "acceptance_criteria",
      "verification_commands",
      "required_artifacts",
      "report_destination"
    ],
    "return_fields": [
      "task_id",
      "status",
      "session_or_run_id",
      "branch",
      "commit_sha",
      "changed_files",
      "test_commands",
      "exit_codes",
      "raw_output",
      "artifact_links",
      "blockers"
    ]
  },
  "reference_profiles": [
    {
      "id": "factory-orchestrator",
      "path": "chatgpt-home/agents/factory-orchestrator.md",
      "status": "reference_only_not_in_native_roster",
      "origin": "Adapted from os-factory/har factory-line skill (Apache-2.0)",
      "reason": "Specialized sequential/parallel station orchestration; no distinct runtime routing or profile binding is defined."
    },
    {
      "id": "harness-controller",
      "path": "chatgpt-home/agents/harness-controller.md",
      "status": "reference_only_not_in_native_roster",
      "origin": "Adapted from 0xenzyme/agent-harness and SUNRNEHUI/agent-harness (MIT)",
      "reason": "Overlaps the canonical blind-sniper controller/planner responsibilities; retained as an implementation pattern, not a second controller."
    },
    {
      "id": "independent-reviewer",
      "path": "chatgpt-home/agents/independent-reviewer.md",
      "status": "reference_only_not_in_native_roster",
      "origin": "Independently authored review-pattern adaptation; no upstream files copied",
      "reason": "Overlaps canonical reviewer and shadow roles; distinct independent execution identity is not available merely from this profile."
    },
    {
      "id": "worker-executor",
      "path": "chatgpt-home/agents/worker-executor.md",
      "status": "reference_only_not_in_native_roster",
      "origin": "Adapted from 0xenzyme worker-runner contract and SUNRNEHUI subagent task template (MIT)",
      "reason": "Execution role is represented by canonical engineer plus host adapter; no separate worker process is created by registering this profile."
    }
  ],
  "reference_profile_policy": "Reference profiles are preserved for design reuse but are not dispatchable native agents. Only entries in agents[] belong to the canonical roster. Promote a reference profile only through an explicit architecture decision, profile allowlist update and runtime acceptance."
}
