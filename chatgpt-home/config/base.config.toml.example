#:schema https://developers.openai.com/codex/config-schema.json

approval_policy = "on-request"
sandbox_mode = "read-only"
web_search = "live"

[history]
persistence = "save-all"

[features]
goals = true
multi_agent = true
hooks = true
memories = true

[agents]
enabled = true
max_concurrent_threads_per_session = 3
